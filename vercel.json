{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://blog-production-ff8f.up.railway.app/"
    },
    {
      "source": "/blog/:caminho(.*)",
      "destination": "https://blog-production-ff8f.up.railway.app/:caminho"
    },
    {
      "source": "/:pagina(como-funciona|exemplos|transparencia|perguntas|contato|privacidade|termos|excluir-conta)",
      "destination": "/:pagina.html"
    },
    {
      "source": "/(home|login|signup|forgot-password|notifications|profile|admin|challenges|invites|participants|reset-password)(/.*)?",
      "destination": "/app.html"
    }
  ]
}
